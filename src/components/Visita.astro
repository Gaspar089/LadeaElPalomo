---
import { negocio } from '../data/negocio';

const calle = negocio.calle.replace(/^Calle\s+/, '');
const [nombreCalle, numero] = calle.split(/,\s*/);
---

<section class="visita" id="visita" aria-labelledby="visita-title">
  <div class="wrap">
    <p class="kicker">Visítanos</p>
    <h2 id="visita-title">
      <span class="parte">{nombreCalle},</span>{' '}<span class="parte">{numero}</span>
    </h2>
    <p class="ciudad">{negocio.cp} {negocio.localidad} · {negocio.provincia}</p>

    <div class="datos">
      <div class="col tel">
        <h3>Teléfono</h3>
        <a class="numero link" href={negocio.telefonoHref}>{negocio.telefono}</a>
      </div>

      <div class="col horario">
        <h3>Horario</h3>
        <dl>
          {
            negocio.horario.map((h) => (
              <div class="fila">
                <dt>{h.dias}</dt>
                <dd>{h.horas}</dd>
              </div>
            ))
          }
        </dl>
        <p class="nota">Horario publicado en su web; confirmar antes de ir.</p>
      </div>

      <div class="col web">
        <h3>Escríbenos</h3>
        <ul>
          <li><a class="link" href={`mailto:${negocio.email}`}>{negocio.email}</a></li>
          <li><a class="link" href={negocio.instagram} target="_blank" rel="noopener">Instagram</a></li>
          <li><a class="link" href={negocio.facebook} target="_blank" rel="noopener">Facebook</a></li>
        </ul>
      </div>
    </div>

    <div class="botones">
      <a class="btn btn--solido" href={negocio.mapa} target="_blank" rel="noopener">Abrir en Google Maps</a>
      <a class="btn btn--cal" href={negocio.telefonoHref}>Llamar al almacén</a>
    </div>
  </div>
</section>

<style>
  .visita {
    padding-block: clamp(80px, 12vh, 140px);
    background: var(--azul);
    color: var(--cal);
  }

  .visita :global(:focus-visible) {
    outline-color: var(--cal);
  }

  .kicker {
    color: color-mix(in srgb, var(--cal) 80%, transparent);
  }

  h2 {
    font-size: clamp(3.2rem, 0.5rem + 8vw, 9.5rem);
    font-stretch: 120%;
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 0.9;
    text-wrap: nowrap;
  }

  .parte {
    display: inline-block;
    white-space: nowrap;
  }

  .ciudad {
    margin-top: 20px;
    font-size: var(--step-1);
  }

  .datos {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 32px 24px;
    margin-top: clamp(48px, 8vh, 88px);
    padding-top: 28px;
    border-top: 1px solid color-mix(in srgb, var(--cal) 30%, transparent);
  }

  .col {
    grid-column: span 4;
    min-width: 0;
  }

  h3 {
    margin-bottom: 14px;
    font-size: var(--step-0);
    font-stretch: 100%;
    font-weight: 600;
    letter-spacing: 0;
    color: color-mix(in srgb, var(--cal) 80%, transparent);
  }

  .numero {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--step-2);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  dl {
    margin: 0;
  }

  .fila {
    display: flex;
    flex-wrap: wrap;
    gap: 0 16px;
    padding-block: 4px;
  }

  dt {
    min-width: 9.5em;
  }

  dd {
    margin: 0;
    font-weight: 650;
    font-variant-numeric: tabular-nums;
  }

  .nota {
    margin-top: 12px;
    font-size: var(--step--1);
    color: color-mix(in srgb, var(--cal) 80%, transparent);
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    overflow-wrap: anywhere;
  }

  .botones {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: clamp(40px, 7vh, 72px);
  }

  .btn--solido {
    background: var(--cal);
    border-color: var(--cal);
    color: var(--azul);
  }

  .btn--solido:hover {
    background: var(--rojo);
    border-color: var(--rojo);
    color: var(--cal);
  }

  .btn--cal {
    background: transparent;
    border-color: var(--cal);
    color: var(--cal);
  }

  .btn--cal:hover {
    background: var(--cal);
    border-color: var(--cal);
    color: var(--azul);
  }

  @media (max-width: 900px) {
    .col {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 600px) {
    h2 {
      font-size: clamp(2.4rem, 11.5vw, 3.2rem);
    }

    .parte {
      display: block;
    }

    .botones .btn {
      flex: 1 1 100%;
    }
  }
</style>
